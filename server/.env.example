# RescueBite Server Environment Configuration Template
# Copy this file to .env and replace placeholder values with your Atlas credentials.
# NEVER commit the real .env file or production secrets to version control.

# Server Port & Environment (Render sets PORT automatically, binds to 0.0.0.0)
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI & Database Name
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net
MONGODB_DB_NAME=rescuebite

# JWT Configuration (minimum 32 random characters)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random_string
JWT_EXPIRES_IN=1d

# Cookie Security (set COOKIE_SECURE=true and COOKIE_SAME_SITE=none for cross-site Vercel+Render)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Allowed Frontend Origins for CORS (comma-separated for multiple origins e.g. Vercel production + preview)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Optional: Seed script persona password
DEMO_USER_PASSWORD=DemoPassword123!

# Cloudinary Storage (Optional - falls back to local disk storage in development)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret